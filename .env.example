# Copy to .env and fill in. Never commit .env.
# Keys are added here as backend modules need them.

# development | test | production (Next.js sets this for dev/build/start)
# NODE_ENV=development

# Company time zone (IANA name). Decides "today", day boundaries and punch dates.
COMPANY_TIMEZONE=Asia/Kolkata

# Browser origins allowed to call the API (the Flutter web build), comma-separated.
# Leave empty if only the mobile apps call the API.
CORS_ALLOWED_ORIGINS=http://localhost:8080

# debug | info | warn | error
LOG_LEVEL=info

# MySQL connection string. For local development, `npm run db:up` starts the
# Docker database below. On GoDaddy, build it from the database details the
# hosting gives you: mysql://USER:PASSWORD@HOST:3306/DATABASE
# (127.0.0.1 rather than localhost: on Windows, localhost tries IPv6 first and is much slower.)
DATABASE_URL=mysql://kc:kc_dev_password@127.0.0.1:3306/kc_admin_portal

# Signs access tokens: at least 32 random characters. Changing it signs everyone out.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# How long a sign-in lasts, in hours (default 12).
AUTH_SESSION_HOURS=12

# Used only by `npm run db:seed` to create the first admin account, if it doesn't exist.
# Remove the password from .env after seeding.
BOOTSTRAP_ADMIN_NAME=Admin
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Failed sign-ins allowed per email and address, and the pause window (minutes).
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15

# Requests per signed-in user per minute.
API_REQUESTS_PER_MINUTE=300

# First month that earns Casual leave (1 day a month), YYYY-MM.
LEAVE_ACCRUAL_START_MONTH=2026-01
